{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion.local/schema/mon-temporal-track-v2.json",
  "title": "MON_TEMPORAL_TRACK_V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["track_id", "clip_id", "version", "body_revision", "stage", "family", "facing", "travel_direction", "posture", "variant", "source_revision", "source_reference_sha256", "frame_profile", "fps", "frames", "loop_mode", "root_motion_policy", "entry_posture", "exit_posture", "events", "interruptible_ranges", "source_checksum", "pack_revision", "track_checksum"],
  "properties": {
    "track_id": {"type": "string", "minLength": 1},
    "clip_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "version": {"const": 2},
    "body_revision": {"type": "string", "minLength": 1},
    "stage": {"enum": ["candidate", "approved"]},
    "family": {"type": "string", "minLength": 1},
    "facing": {"enum": ["front", "front_right", "right", "back_right", "back", "back_left", "left", "front_left"]},
    "travel_direction": {"type": ["string", "null"]},
    "posture": {"type": "string", "minLength": 1},
    "variant": {"type": "integer", "minimum": 1, "maximum": 99},
    "source_revision": {"type": "string", "minLength": 1},
    "source_reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frame_profile": {"const": "MON_FRAME_V1"},
    "fps": {"const": 24},
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame_id", "frame_index", "duration_ticks", "path", "sha256", "source_pose_id", "landmarks", "contacts", "events"],
        "properties": {
          "frame_id": {"type": "string", "minLength": 1},
          "frame_index": {"type": "integer", "minimum": 0},
          "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 240},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_pose_id": {"type": "string", "minLength": 1},
          "landmarks": {"$ref": "#/$defs/landmarks"},
          "contacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["landmark", "active"], "properties": {"landmark": {"type": "string"}, "active": {"type": "boolean"}}}},
          "events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "tick"], "properties": {"kind": {"type": "string"}, "tick": {"type": "integer", "minimum": 0}}}}
        }
      }
    },
    "loop_mode": {"enum": ["once", "loop", "ping_pong"]},
    "root_motion_policy": {"const": "forbidden"},
    "entry_posture": {"type": "string", "minLength": 1},
    "exit_posture": {"type": "string", "minLength": 1},
    "events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "frame_index"], "properties": {"kind": {"type": "string"}, "frame_index": {"type": "integer", "minimum": 0}}}},
    "interruptible_ranges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "minItems": 2, "maxItems": 2}},
    "source_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_revision": {"type": "string", "minLength": 1},
    "track_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "landmark": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
    "landmarks": {"type": "object", "additionalProperties": false, "required": ["root", "left_foot", "right_foot", "head", "eye_left", "eye_right"], "properties": {"root": {"$ref": "#/$defs/landmark"}, "left_foot": {"$ref": "#/$defs/landmark"}, "right_foot": {"$ref": "#/$defs/landmark"}, "head": {"$ref": "#/$defs/landmark"}, "eye_left": {"$ref": "#/$defs/landmark"}, "eye_right": {"$ref": "#/$defs/landmark"}}}
  }
}
