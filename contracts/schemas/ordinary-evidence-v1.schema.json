{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion.local/schema/ordinary-evidence-v1.schema.json",
  "title": "Authenticated ordinary evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_major", "message_id", "producer_generation", "source", "observed_at", "monotonic_ns", "confidence_milli", "quality_milli", "replay", "causation_id", "correlation_id", "auth_scheme", "mac", "payload"],
  "properties": {
    "schema_major": {"const": 1},
    "message_id": {"type": "string", "format": "uuid"},
    "producer_generation": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
    "quality_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
    "replay": {"type": "boolean", "const": false},
    "causation_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "correlation_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "auth_scheme": {"enum": ["hmac-sha256-jcs-v1", "scm-credentials-v1"]},
    "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "subject", "value"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
