{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion.local/schema/mon-authored-frame-pack-v1.json",
  "title": "MON_AUTHORED_FRAME_PACK_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "schema_version", "pack_id", "pack_revision", "body_revision", "developmental_stage", "approval_state", "approved_references", "provenance", "timing", "tracks", "source_runtime_relationships"],
  "properties": {
    "profile": {"const": "MON_AUTHORED_FRAME_PACK_V1"},
    "schema_version": {"const": 1},
    "pack_id": {"type": "string", "format": "uuid"},
    "pack_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "body_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "developmental_stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
    "approval_state": {"$ref": "#/$defs/approval_state"},
    "approved_references": {"$ref": "#/$defs/approved_references"},
    "provenance": {"$ref": "#/$defs/pack_provenance"},
    "timing": {"$ref": "#/$defs/timing_profile"},
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}},
    "source_runtime_relationships": {"type": "array", "items": {"$ref": "#/$defs/source_runtime_relationship"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_state": {"enum": ["candidate", "operator_approved", "rejected", "synthetic_test_only"]},
    "facing": {"enum": ["front", "front_right", "right", "back_right", "back", "back_left", "left", "front_left"]},
    "posture": {"enum": ["neutral", "listening", "acknowledging", "walking"]},
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 1023}, "y": {"type": "integer", "minimum": 0, "maximum": 1023}}
    },
    "landmarks": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "head", "eye_left", "eye_right", "hand_left", "hand_right", "foot_left", "foot_right"],
      "properties": {
        "root": {"$ref": "#/$defs/point"}, "head": {"$ref": "#/$defs/point"},
        "eye_left": {"$ref": "#/$defs/point"}, "eye_right": {"$ref": "#/$defs/point"},
        "hand_left": {"$ref": "#/$defs/point"}, "hand_right": {"$ref": "#/$defs/point"},
        "foot_left": {"$ref": "#/$defs/point"}, "foot_right": {"$ref": "#/$defs/point"}
      }
    },
    "approved_references": {
      "type": "object", "additionalProperties": false, "required": ["identity_sha256", "turnaround_sha256"],
      "properties": {"identity_sha256": {"$ref": "#/$defs/sha256"}, "turnaround_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "pack_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["art_authority", "generation_or_edit_method", "source_authority", "rights_record"],
      "properties": {
        "art_authority": {"type": "string", "minLength": 1}, "generation_or_edit_method": {"type": "string", "minLength": 1},
        "source_authority": {"type": "string", "minLength": 1}, "rights_record": {"type": "string", "minLength": 1}
      }
    },
    "timing_profile": {
      "type": "object", "additionalProperties": false, "required": ["fps", "tick_unit"],
      "properties": {"fps": {"const": 24}, "tick_unit": {"const": "1/24_second"}}
    },
    "frame_provenance": {
      "type": "object", "additionalProperties": false, "required": ["authored_by", "method", "source_revision"],
      "properties": {"authored_by": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}}
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "frame_index", "filename", "sidecar_filename", "duration_ticks", "source_sha256", "root", "landmarks", "provenance"],
      "properties": {
        "frame_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 999},
        "filename": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}__(front|front_right|right|back_right|back|back_left|left|front_left)__(neutral|listening|acknowledging|walking)__v[0-9]{2}__f[0-9]{3}\\.png$"},
        "sidecar_filename": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}__(front|front_right|right|back_right|back|back_left|left|front_left)__(neutral|listening|acknowledging|walking)__v[0-9]{2}__f[0-9]{3}\\.frame\\.json$"},
        "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 240},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "root": {"$ref": "#/$defs/point"},
        "landmarks": {"$ref": "#/$defs/landmarks"}, "provenance": {"$ref": "#/$defs/frame_provenance"}
      }
    },
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["landmark", "state", "start_tick", "end_tick"],
      "properties": {
        "landmark": {"enum": ["foot_left", "foot_right", "hand_left", "hand_right"]},
        "state": {"enum": ["planted", "swing", "clear"]},
        "start_tick": {"type": "integer", "minimum": 0}, "end_tick": {"type": "integer", "minimum": 1}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["name", "tick", "frame_index"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "tick": {"type": "integer", "minimum": 0}, "frame_index": {"type": "integer", "minimum": 0}}
    },
    "interruption": {
      "type": "object", "additionalProperties": false, "required": ["start_tick", "end_tick"],
      "properties": {"start_tick": {"type": "integer", "minimum": 0}, "end_tick": {"type": "integer", "minimum": 1}}
    },
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["track_id", "family", "facing", "posture", "variant", "entry_posture", "exit_posture", "completion", "frames", "contacts", "events", "interruption_ranges", "track_checksum"],
      "properties": {
        "track_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "facing": {"$ref": "#/$defs/facing"},
        "posture": {"$ref": "#/$defs/posture"}, "variant": {"type": "integer", "minimum": 1, "maximum": 99},
        "entry_posture": {"$ref": "#/$defs/posture"}, "exit_posture": {"$ref": "#/$defs/posture"},
        "completion": {"enum": ["once", "loop"]}, "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
        "contacts": {"type": "array", "items": {"$ref": "#/$defs/contact"}}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "interruption_ranges": {"type": "array", "items": {"$ref": "#/$defs/interruption"}}, "track_checksum": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_runtime_relationship": {
      "type": "object", "additionalProperties": false, "required": ["source_sha256", "content_address", "runtime_asset"],
      "properties": {"source_sha256": {"$ref": "#/$defs/sha256"}, "content_address": {"type": "string", "minLength": 1}, "runtime_asset": {"type": "string", "minLength": 1}}
    }
  }
}
