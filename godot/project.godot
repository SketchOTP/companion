; Phase 01 neutral habitat shell. No production assets or runtime capability.
config_version=5

[application]
config/name="Companion Mon Embodiment Candidate"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=960
window/size/window_height_override=540
window/size/window_min_width=640
window/size/window_min_height=360
window/size/window_max_width=1366
window/size/window_max_height=768
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[gui]
theme/default_font_multichannel_signed_distance_field=true
